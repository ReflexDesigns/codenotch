{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Codenotch",
  "version": "0.5.4",
  "identifier": "com.immidi.codenotch",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "notch",
        "url": "notch.html",
        "width": 340,
        "height": 460,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "visible": false,
        "focus": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/ReflexDesigns/codenotch/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI3Njc2NDBBMjVFNDRCMTAKUldRUVMrUWxDbVJudDBXelVYblZHVHpPUUk4Ym9IbzZKOW1RNHRmN083SWV2dEUwL1I2SjNXT2wK",
      "windows": {
        "installMode": "quiet"
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "externalBin": [
      "../target/release/codenotch-hook"
    ]
  }
}
